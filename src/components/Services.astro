---
// (06) — Services, Lequon style: intro, availability pill, "every project
// includes" list, then an accordion of services with square +/− toggles.
import SectionHead from './SectionHead.astro';
import { services, included, profile } from '../data/profile';
---

<section id="services" class="lq services" aria-labelledby="services-title">
  <SectionHead num="06" label="Services" id="services-title" before="What I " accent="offer" />

  <div class="intro">
    <p class="lede">
      A focused menu, built and handed over by me. One point of contact from the first message to launch, with
      fixed-price milestones agreed up front.
    </p>
    <p class="pill"><span class="dot" aria-hidden="true"></span>Available · {profile.availability}</p>
  </div>

  <div class="includes">
    <p class="mono">Every project includes</p>
    <ul>
      {included.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <ul class="list" data-accordion>
    {
      services.map((s, i) => (
        <li class:list={['row', { open: i === 0 }]}>
          <button
            class="trigger"
            type="button"
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-controls={`svc-${i}`}
            id={`svc-btn-${i}`}
          >
            <span class="idx">-{String(i + 1).padStart(2, '0')}</span>
            <span class="name">{s.title}</span>
            <span class="toggle" aria-hidden="true">
              <span class="bar" />
              <span class="bar v" />
            </span>
          </button>
          <div class="panel" id={`svc-${i}`} role="region" aria-labelledby={`svc-btn-${i}`}>
            <div class="panel-inner">
              <p class="desc">{s.body}</p>
              <p class="mono tools">{s.tools}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .lq {
    --paper: #f4f2ee;
    --ink: #111;
    --muted: rgba(17, 17, 17, 0.7);
    --line: rgba(17, 17, 17, 0.16);
    --orange: #ff4a1f;
    --open: #e9e5da;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Bricolage Grotesque', 'Geist', sans-serif;
    /* Same centred 1120px column as About and Selected work. */
    padding-inline: max(32px, calc((100% - 1120px) / 2));
  }
  .mono {
    max-width: none;
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .intro {
    display: grid;
    gap: 18px;
    padding: 0 0 32px;
  }
  .lede {
    max-width: 62ch;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--muted);
  }
  .pill {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border: 1px solid var(--ink);
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  .includes {
    display: grid;
    gap: 14px;
    padding: 24px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }
  .includes ul {
    display: grid;
    gap: 6px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .includes li {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .includes li::before {
    content: '+ ';
    color: var(--orange);
  }

  /* Accordion */
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }
  .row {
    border-bottom: 1px solid var(--line);
    transition: background-color 400ms ease;
  }
  .row.open {
    background: var(--open);
  }
  .trigger {
    display: grid;
    grid-template-columns: 30px 1fr auto;
    align-items: center;
    gap: 16px;
    width: 100%;
    min-height: 88px;
    padding: 16px 24px;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .idx {
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .name {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .trigger:hover .name {
    transform: translateX(6px);
  }
  .toggle {
    position: relative;
    width: 36px;
    height: 36px;
    border: 1px solid var(--ink);
    transition: background-color 300ms ease;
  }
  .bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 1.5px;
    background: var(--ink);
    transform: translate(-50%, -50%);
    transition:
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 300ms ease;
  }
  .bar.v {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .row.open .toggle {
    background: var(--ink);
  }
  .row.open .bar {
    background: var(--paper);
  }
  .row.open .bar.v {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .trigger:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: -4px;
  }
  .panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .row.open .panel {
    grid-template-rows: 1fr;
  }
  .panel-inner {
    min-height: 0;
    overflow: hidden;
    display: grid;
    gap: 14px;
    padding: 0 24px;
    transition: padding 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .row.open .panel-inner {
    padding: 0 24px 28px;
  }
  .desc {
    max-width: 44ch;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .tools {
    color: var(--ink);
  }

  @media (min-width: 760px) {
    .includes ul {
      grid-template-columns: 1fr 1fr;
    }
    .panel-inner,
    .row.open .panel-inner {
      padding-left: 70px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel,
    .panel-inner,
    .bar,
    .name,
    .dot {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  // One open row at a time; clicking the open row closes it.
  const list = document.querySelector<HTMLElement>('[data-accordion]');
  list?.querySelectorAll<HTMLButtonElement>('.trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const row = btn.closest('.row')!;
      const opening = !row.classList.contains('open');
      list.querySelectorAll('.row').forEach((r) => {
        r.classList.remove('open');
        r.querySelector('.trigger')!.setAttribute('aria-expanded', 'false');
      });
      if (opening) {
        row.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
