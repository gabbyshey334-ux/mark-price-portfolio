---
// Leo Marlowe-style About: word-by-word statement, three-step tray, and a
// macOS-dock toolbox that magnifies under the cursor.
import { toolbox } from '../data/toolbox';

const lead = 'I’m a full-stack WordPress developer. I build websites and fix the broken ones —';
const tail = 'fast on a phone, easy for your team to update.';
const words = [
  ...lead.split(' ').map((w) => ({ w, muted: false })),
  ...tail.split(' ').map((w) => ({ w, muted: true })),
];

const steps = [
  {
    title: 'Build',
    body: 'Custom themes, WooCommerce stores and multilingual sites.',
    icon: 'code',
  },
  {
    title: 'Speed up',
    body: 'Image-heavy sites made fast, measured before and after.',
    icon: 'bolt',
  },
  {
    title: 'Look after',
    body: 'Fixes, updates on staging, backups and monthly care.',
    icon: 'shield',
    accent: true,
  },
];
---

<section id="about" class="about" aria-labelledby="about-title" data-about>
  <p class="eyebrow">(02) — About</p>

  <h2 id="about-title" class="statement">
    {
      words.map((x, i) => (
        <>
          <span class:list={['word', { muted: x.muted }]} style={`--i:${i}`}>
            {x.w}
          </span>{' '}
        </>
      ))
    }
  </h2>

  <div class="tray">
    {
      steps.map((s, i) => (
        <div class="step" style={`--i:${i}`}>
          <span class:list={['icon', { accent: s.accent }]} aria-hidden="true">
            {s.icon === 'code' && (
              <svg viewBox="0 0 24 24" width="18" height="18">
                <path d="m8 7-5 5 5 5M16 7l5 5-5 5M13.5 5l-3 14" />
              </svg>
            )}
            {s.icon === 'bolt' && (
              <svg viewBox="0 0 24 24" width="18" height="18">
                <path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12L13 2Z" />
              </svg>
            )}
            {s.icon === 'shield' && (
              <svg viewBox="0 0 24 24" width="18" height="18">
                <path d="M12 3 5 6v5.5c0 4.3 3 8 7 9.5 4-1.5 7-5.2 7-9.5V6l-7-3Z" />
                <path d="m9 12 2.2 2.2L15.5 10" />
              </svg>
            )}
          </span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))
    }
  </div>

  <hr class="rule" />

  <p class="eyebrow">Daily toolbox</p>
  <ul class="dock" data-dock aria-label="Tools I use every day">
    {
      toolbox.map((t, i) => (
        <li class="slot" style={`--i:${i}`}>
          <span class:list={['tile', { wide: t.wide }]} data-tile tabindex="0" aria-label={t.name}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={t.d} />
            </svg>
          </span>
          <span class="tip" aria-hidden="true">
            {t.name}
          </span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .about {
    --paper: #f4f2ee;
    --ink: #1a1917;
    --muted: #6b6862;
    --tray: #e9e6e0;
    --accent: #c0603e;

    background: var(--paper);
    color: var(--ink);
    padding: 96px 32px;
    display: grid;
    justify-items: center;
    font-family: 'Geist', var(--font);
  }

  .eyebrow {
    max-width: none;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .statement {
    max-width: 17.5em;
    margin: 28px 0 64px;
    text-align: center;
    font-family: 'Fraunces', Georgia, serif;
    font-optical-sizing: auto;
    font-weight: 400;
    font-stretch: 100%;
    font-size: clamp(28px, 1.2rem + 2.2vw, 44px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .word {
    display: inline-block;
  }
  .muted {
    color: var(--muted);
  }

  /* Tray holding the three steps. */
  .tray {
    width: 100%;
    max-width: 1120px;
    display: grid;
    gap: 6px;
    padding: 6px;
    border-radius: 26px;
    background: var(--tray);
  }
  .step {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0;
    padding: 32px 24px;
    border-radius: 20px;
    background: var(--paper);
    text-align: center;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    margin-bottom: 28px;
  }
  .icon.accent {
    background: var(--accent);
  }
  .icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .step h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-optical-sizing: auto;
    font-weight: 400;
    font-size: 24px;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }
  .step p {
    max-width: 24ch;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
    letter-spacing: -0.005em;
  }

  .rule {
    width: 100%;
    max-width: 1120px;
    height: 1px;
    margin: 64px 0 36px;
    border: 0;
    background: rgba(26, 25, 23, 0.1);
  }

  /* Dock. Slots keep the layout fixed; tiles scale from their bottom edge. */
  .dock {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  .slot {
    position: relative;
    width: 48px;
    height: 48px;
  }
  .tile {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 28%;
    background: var(--tray);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
    color: var(--ink);
    transform-origin: 50% 100%;
    transform: scale(var(--s, 1));
    transition: box-shadow 400ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    cursor: default;
  }
  .tile svg {
    width: 52%;
    height: 52%;
    fill: currentColor;
  }
  /* Wordmark logos (wide, short) get more room so they read at tile size. */
  .tile.wide svg {
    width: 82%;
    height: 82%;
  }
  .slot.active .tile {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      0 10px 24px -12px rgba(26, 25, 23, 0.35);
  }
  .tile:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% * var(--s, 1) + 8px);
    padding: 7px 12px;
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    box-shadow:
      0 0 0 1px rgba(26, 25, 23, 0.08),
      0 14px 28px -14px rgba(26, 25, 23, 0.45);
    opacity: 0;
    transform: translate(-50%, 4px);
    transition:
      opacity 200ms ease,
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    z-index: 2;
  }
  .slot.active .tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (min-width: 760px) {
    .tray {
      grid-template-columns: repeat(3, 1fr);
    }
    .dock {
      flex-wrap: nowrap;
    }
  }

  /* Entrance: words rise and sharpen one by one, then the cards and tiles.
     Only hidden once JS has marked the section, so content never stays invisible. */
  @media (prefers-reduced-motion: no-preference) {
    .about.pre .word {
      opacity: 0;
      filter: blur(6px);
      transform: translateY(0.35em);
    }
    .about.pre .step,
    .about.pre .slot {
      opacity: 0;
      transform: translateY(16px);
    }
    .word {
      transition:
        opacity 700ms ease calc(var(--i) * 35ms),
        filter 700ms ease calc(var(--i) * 35ms),
        transform 800ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i) * 35ms);
    }
    .step {
      transition:
        opacity 700ms ease calc(450ms + var(--i) * 90ms),
        transform 800ms cubic-bezier(0.22, 1, 0.36, 1) calc(450ms + var(--i) * 90ms);
    }
    .slot {
      transition:
        opacity 500ms ease calc(700ms + var(--i) * 40ms),
        transform 600ms cubic-bezier(0.22, 1, 0.36, 1) calc(700ms + var(--i) * 40ms);
    }
  }
</style>

<script>
  const about = document.querySelector<HTMLElement>('[data-about]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scroll-in reveal.
  if (about && !reduce && about.getBoundingClientRect().top > innerHeight * 0.85) {
    about.classList.add('pre');
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          about.classList.remove('pre');
          io.disconnect();
        }
      },
      { threshold: 0.2 },
    );
    io.observe(about);
  }

  // Dock magnification: scale each tile by its distance to the cursor, eased.
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) {
    const slots = [...dock.querySelectorAll<HTMLElement>('.slot')];
    const tiles = slots.map((s) => s.querySelector<HTMLElement>('.tile')!);
    const MAX = 0.32; // hovered tile grows 32%
    const RANGE = 130; // px of influence either side
    const current = slots.map(() => 1);
    let target = slots.map(() => 1);
    let raf = 0;

    const setTargets = (x: number | null) => {
      target = slots.map((s) => {
        if (x === null) return 1;
        const r = s.getBoundingClientRect();
        const d = Math.abs(x - (r.left + r.width / 2));
        const k = Math.max(0, 1 - d / RANGE);
        return 1 + MAX * (k * k * (3 - 2 * k)); // smoothstep falloff
      });
    };
    const setActive = (i: number | null) => slots.forEach((s, j) => s.classList.toggle('active', j === i));

    const tick = () => {
      let moving = false;
      for (let i = 0; i < tiles.length; i++) {
        const next = current[i] + (target[i] - current[i]) * (reduce ? 1 : 0.22);
        if (Math.abs(next - target[i]) > 0.001) moving = true;
        current[i] = next;
        slots[i].style.setProperty('--s', next.toFixed(4));
      }
      raf = moving ? requestAnimationFrame(tick) : 0;
    };
    const run = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    dock.addEventListener('pointermove', (e) => {
      setTargets(e.clientX);
      const i = slots.findIndex((s) => {
        const r = s.getBoundingClientRect();
        return e.clientX >= r.left - 5 && e.clientX <= r.right + 5;
      });
      setActive(i >= 0 ? i : null);
      run();
    });
    dock.addEventListener('pointerleave', () => {
      setTargets(null);
      setActive(null);
      run();
    });
    // Keyboard: focusing a tile magnifies it and shows its name.
    tiles.forEach((t, i) =>
      t.addEventListener('focus', () => {
        const r = slots[i].getBoundingClientRect();
        setTargets(r.left + r.width / 2);
        setActive(i);
        run();
      }),
    );
    dock.addEventListener('focusout', (e) => {
      if (!dock.contains(e.relatedTarget as Node)) {
        setTargets(null);
        setActive(null);
        run();
      }
    });
  }
</script>
