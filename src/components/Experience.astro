---
// (04) — Experience, following Leo Marlowe's Experience section: a narrow tray
// of rows with an initials tile, company, role, and a mono pill on the right.
import { experience, profile } from '../data/profile';

const label = 'Full profile on Upwork';
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <p class="eyebrow">(04) — Experience</p>
  <h2 id="experience-title" class="title">
    Contract work for hotels, <span class="muted">studios and shops.</span>
  </h2>

  <ul class="tray">
    {
      experience.map((x) => {
        const Tag = x.slug ? 'a' : 'div';
        return (
          <li>
            <Tag class:list={['row', { link: !!x.slug }]} href={x.slug ? `/work/${x.slug}/` : undefined}>
              <span class="tile" aria-hidden="true">
                {x.initials}
              </span>
              <span class="text">
                <span class="company">
                  {x.company}
                  {x.now && (
                    <span class="now">
                      <span class="now-dot" aria-hidden="true" />
                      Now
                    </span>
                  )}
                </span>
                <span class="role">{x.role}</span>
              </span>
              <span class="pill">{x.tag}</span>
            </Tag>
          </li>
        );
      })
    }
  </ul>

  <a class="more" href={profile.upwork} target="_blank" rel="noopener">
    <span class="roll" aria-label={label}>
      {[...label].map((c, j) => (
        <span class="ch" style={`--j:${j}`} aria-hidden="true"><span>{c === ' ' ? ' ' : c}</span></span>
      ))}
    </span>
    <span class="arrow" aria-hidden="true">↗</span>
    <span class="visually-hidden"> (opens in a new tab)</span>
  </a>
</section>

<style>
  .experience {
    --paper: #f4f2ee;
    --ink: #1a1917;
    --muted: #6b6862;
    --tray: #e9e6e0;
    --accent: #c0603e;

    display: grid;
    justify-items: center;
    padding: 96px 32px;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Geist', var(--font);
  }
  .eyebrow,
  .pill {
    max-width: none;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .title {
    max-width: 16em;
    margin: 28px 0 40px;
    text-align: center;
    font-family: 'Fraunces', Georgia, serif;
    font-optical-sizing: auto;
    font-weight: 400;
    font-stretch: 100%;
    font-size: clamp(30px, 1.3rem + 1.8vw, 44px);
    line-height: 1.07;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .muted {
    color: var(--muted);
  }

  /* Tray of rows */
  .tray {
    width: 100%;
    max-width: 720px;
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 6px;
    list-style: none;
    border-radius: 26px;
    background: var(--tray);
  }
  .row {
    display: grid;
    grid-template-columns: 46px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 16px 20px 16px 16px;
    border-radius: 20px;
    background: var(--paper);
    color: inherit;
    text-decoration: none;
    transition:
      transform 450ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 450ms ease;
  }
  .row.link:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px -16px rgba(26, 25, 23, 0.35);
  }
  .row.link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .tile {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--ink);
    color: var(--paper);
    font-family: 'Fraunces', Georgia, serif;
    font-size: 17px;
    letter-spacing: -0.02em;
  }
  .text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .company {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: 'Fraunces', Georgia, serif;
    font-optical-sizing: auto;
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .now {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 8px;
    border-radius: 100px;
    background: rgba(192, 96, 62, 0.12);
    color: var(--accent);
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .now-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    animation: blink 2s ease-in-out infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }
  .role {
    font-size: 15px;
    line-height: 1.4;
    letter-spacing: -0.005em;
    color: var(--muted);
  }
  .pill {
    padding: 6px 12px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgba(26, 25, 23, 0.12);
    white-space: nowrap;
  }

  /* Button with letter roll */
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 32px;
    padding: 15px 20px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgba(26, 25, 23, 0.12);
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition:
      background-color 300ms ease,
      box-shadow 300ms ease;
  }
  .more:hover {
    background: var(--tray);
  }
  .more:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .roll {
    display: inline-flex;
  }
  .ch {
    display: inline-block;
    height: 1.2em;
    overflow: hidden;
    line-height: 1.2;
  }
  .ch > span {
    display: block;
    text-shadow: 0 1.2em 0 currentColor;
    transition: transform 500ms cubic-bezier(0.65, 0, 0.35, 1) calc(var(--j) * 14ms);
  }
  .more:hover .ch > span,
  .more:focus-visible .ch > span {
    transform: translateY(-1.2em);
  }
  .arrow {
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .more:hover .arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 46px 1fr;
    }
    .pill {
      grid-column: 2;
      justify-self: start;
    }
    .company {
      font-size: 19px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row,
    .ch > span,
    .arrow,
    .now-dot {
      transition: none;
      animation: none;
    }
  }
</style>
