---
// Leo Marlowe-style Selected work: rounded image cards with a glass badge
// that grows into "View case" and follows the cursor, a letter-roll title,
// and a meta dot that stretches into a line on hover.
import { projects } from '../data/projects';

// Six cards keep the two-column grid even; every project keeps its case page.
const cards = projects.slice(0, 6);

const hexToRgb = (hex: string) => {
  const n = parseInt(hex.slice(1), 16);
  return `${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}`;
};
---

<section id="work" class="work" aria-labelledby="work-title">
  <p class="eyebrow">(03) — Selected work</p>
  <h2 id="work-title" class="title">Selected <span class="muted">work</span></h2>
  <p class="range">Live client sites</p>

  <ul class="grid">
    {
      cards.map((p, i) => (
        <li class="item" style={`--i:${i}`}>
          <a class="card" href={`/work/${p.slug}/`} style={`--tone:${p.tone};--tone-rgb:${hexToRgb(p.tone)}`} data-card>
            <div class="cover" data-cover>
              <div class="media" data-media>
                {p.image ? (
                  <img src={p.image} alt={`${p.client} website home page`} width="800" height="813" loading="lazy" decoding="async" />
                ) : (
                  <div class="placeholder" aria-hidden="true" />
                )}
              </div>
              <span class="ring" aria-hidden="true" />
              <span class="badge" data-badge aria-hidden="true">
                <span class="mono">{p.client.charAt(0)}</span>
                <span class="cta">
                  View case <span class="arrow">↗</span>
                </span>
              </span>
            </div>

            <h3 class="name" aria-label={p.client}>
              {[...p.client].map((ch, j) => (
                <span class="ch" style={`--j:${j}`} aria-hidden="true">
                  <span>{ch === ' ' ? ' ' : ch}</span>
                </span>
              ))}
            </h3>
            <p class="meta">
              <span>{p.sector}</span>
              <span class="dot" aria-hidden="true" />
              <span>{p.stack[0]}</span>
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .work {
    --paper: #f4f2ee;
    --ink: #1a1917;
    --muted: #6b6862;

    display: grid;
    justify-items: center;
    padding: 96px 32px;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Geist', var(--font);
  }
  .eyebrow,
  .range,
  .meta {
    max-width: none;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .title {
    margin: 28px 0 12px;
    font-family: 'Fraunces', Georgia, serif;
    font-optical-sizing: auto;
    font-weight: 400;
    font-stretch: 100%;
    font-size: clamp(30px, 1.4rem + 1.4vw, 40px);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .muted {
    color: var(--muted);
  }

  .grid {
    width: 100%;
    max-width: 1120px;
    display: grid;
    gap: 56px 20px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: grid;
    justify-items: center;
    color: inherit;
    text-decoration: none;
  }

  /* Cover */
  .cover {
    position: relative;
    width: 100%;
    aspect-ratio: 374 / 380;
    border-radius: 24px;
    overflow: hidden;
    background: var(--tone);
    isolation: isolate;
  }
  .media {
    position: absolute;
    inset: 0;
    transform: translate3d(var(--mx, 0px), var(--my, 0px), 0) scale(var(--ms, 1));
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 30% 20%, rgba(255, 255, 255, 0.22), transparent 55%),
      radial-gradient(90% 80% at 80% 100%, rgba(0, 0, 0, 0.28), transparent 60%),
      var(--tone);
  }
  .ring {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(26, 25, 23, 0.06);
    pointer-events: none;
  }

  /* Glass badge: a 61px circle that grows into a "View case" pill. */
  .badge {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    height: 61px;
    padding: 0 0 0 0;
    border-radius: 999px;
    background: rgba(var(--tone-rgb), 0.62);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 0 0 1px rgba(255, 255, 255, 0.18),
      0 10px 30px -12px rgba(0, 0, 0, 0.35);
    color: #fff;
    transform: translate(calc(-50% + var(--bx, 0px)), calc(-50% + var(--by, 0px)));
    white-space: nowrap;
    pointer-events: none;
  }
  .mono {
    display: grid;
    place-items: center;
    width: 61px;
    height: 61px;
    flex: none;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 24px;
    line-height: 1;
  }
  .cta {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition:
      max-width 450ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 250ms ease,
      padding 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .arrow {
    display: inline-block;
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card:hover .cta,
  .card:focus-visible .cta {
    max-width: 120px;
    opacity: 1;
    padding-right: 22px;
    margin-left: -8px;
  }
  .card:hover .arrow {
    transform: translate(1px, -1px);
  }

  /* Title: each letter rolls up to an identical copy below it. */
  .name {
    margin-top: 18px;
    display: flex;
    font-family: 'Fraunces', Georgia, serif;
    font-optical-sizing: auto;
    font-weight: 400;
    font-size: 24px;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }
  .ch {
    display: inline-block;
    height: 1.18em;
    overflow: hidden;
  }
  .ch > span {
    display: block;
    text-shadow: 0 1.18em 0 currentColor;
    transition: transform 500ms cubic-bezier(0.65, 0, 0.35, 1) calc(var(--j) * 18ms);
  }
  .card:hover .ch > span,
  .card:focus-visible .ch > span {
    transform: translateY(-1.18em);
  }

  /* Meta: the dot stretches into a line and the text darkens. */
  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    transition: color 400ms ease;
  }
  .dot {
    width: 3px;
    height: 3px;
    border-radius: 3px;
    background: currentColor;
    transition: width 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card:hover .meta,
  .card:focus-visible .meta {
    color: var(--ink);
  }
  .card:hover .dot,
  .card:focus-visible .dot {
    width: 24px;
  }

  .card:focus-visible {
    outline: none;
  }
  .card:focus-visible .cover {
    outline: 2px solid #c0603e;
    outline-offset: 4px;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .work.pre .item {
      opacity: 0;
      transform: translateY(24px);
    }
    .item {
      transition:
        opacity 800ms ease calc(var(--i) * 80ms),
        transform 900ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i) * 80ms);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .media,
    .ch > span,
    .dot,
    .cta {
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#work');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Cards rise in as the section scrolls into view.
  if (section && !reduce && section.getBoundingClientRect().top > innerHeight * 0.85) {
    section.classList.add('pre');
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          section.classList.remove('pre');
          io.disconnect();
        }
      },
      { threshold: 0.08 },
    );
    io.observe(section);
  }

  // Hover: the badge follows the cursor (eased) and the image zooms and drifts.
  if (matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
      const cover = card.querySelector<HTMLElement>('[data-cover]')!;
      const media = card.querySelector<HTMLElement>('[data-media]')!;
      const badge = card.querySelector<HTMLElement>('[data-badge]')!;
      let tx = 0;
      let ty = 0;
      let x = 0;
      let y = 0;
      let raf = 0;

      const tick = () => {
        x += (tx - x) * (reduce ? 1 : 0.16);
        y += (ty - y) * (reduce ? 1 : 0.16);
        badge.style.setProperty('--bx', `${x.toFixed(2)}px`);
        badge.style.setProperty('--by', `${y.toFixed(2)}px`);
        raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(tick) : 0;
      };
      const run = () => {
        if (!raf) raf = requestAnimationFrame(tick);
      };

      cover.addEventListener('pointermove', (e) => {
        const r = cover.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        tx = dx;
        ty = dy;
        media.style.setProperty('--ms', reduce ? '1' : '1.1');
        media.style.setProperty('--mx', `${(dx / r.width) * -14}px`);
        media.style.setProperty('--my', `${(dy / r.height) * -14}px`);
        run();
      });
      cover.addEventListener('pointerleave', () => {
        tx = 0;
        ty = 0;
        media.style.setProperty('--ms', '1');
        media.style.setProperty('--mx', '0px');
        media.style.setProperty('--my', '0px');
        run();
      });
    });
  }
</script>
