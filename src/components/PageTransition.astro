---
// Affinitty-style page switch: three full-screen colour panels sweep in from
// the left (yellow, orange, then ink on top), the next page loads under them,
// then they sweep out to the right in the same order to reveal it.
// Works with plain multi-page navigation: the "arriving" state is set before
// first paint by an inline script in <head> (see Base.astro), so the new page
// never flashes before the panels leave.
---

<div class="pt" aria-hidden="true" data-pt>
  <span class="pt-panel pt-1"></span>
  <span class="pt-panel pt-2"></span>
  <span class="pt-panel pt-3"></span>
</div>

<style is:global>
  .pt {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    overflow: hidden;
  }
  .pt-panel {
    position: absolute;
    inset: -2px;
    will-change: transform;
    backface-visibility: hidden;
    transform: translate3d(-101%, 0, 0);
    transition: transform 650ms cubic-bezier(0.76, 0, 0.24, 1);
  }
  /* Site colours: hero yellow, section orange, then ink on top. */
  .pt-1 {
    background: #ffff00;
    z-index: 1;
  }
  .pt-2 {
    background: #ff4a1f;
    z-index: 2;
  }
  .pt-3 {
    background: #1a1917;
    z-index: 3;
  }
  /* Stagger: yellow leads, ink lands last and covers the screen. */
  .pt-2 {
    transition-delay: 90ms;
  }
  .pt-3 {
    transition-delay: 180ms;
  }

  /* Leaving: sweep in to cover. */
  html.pt-in .pt {
    pointer-events: auto;
  }
  html.pt-in .pt-panel {
    transform: translate3d(0, 0, 0);
  }

  /* Arriving: covered from the first paint, no transition yet. */
  html.pt-arrive .pt-panel {
    transform: translate3d(0, 0, 0);
    transition: none;
  }
  /* Revealing: sweep out to the right, same order. */
  html.pt-out .pt-panel {
    transform: translate3d(101%, 0, 0);
  }
  /* Instant park back on the left after the reveal. */
  html.pt-reset .pt-panel {
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .pt {
      display: none;
    }
  }
</style>

<script>
  const KEY = 'pt-arrive';
  const root = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const last = document.querySelector<HTMLElement>('.pt-3');

  const afterLast = (fn: () => void) => {
    if (!last) return fn();
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      fn();
    };
    last.addEventListener('transitionend', finish, { once: true });
    setTimeout(finish, 1200); // safety net if transitionend never fires
  };

  // Reveal the page we just arrived on.
  const reveal = () => {
    if (!root.classList.contains('pt-arrive')) return;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        root.classList.remove('pt-arrive');
        root.classList.add('pt-out');
        // Park the panels back on the left without animating them across the screen.
        afterLast(() => {
          root.classList.add('pt-reset');
          root.classList.remove('pt-out');
          void root.offsetWidth;
          root.classList.remove('pt-reset');
        });
      });
    });
  };
  reveal();

  // Back/forward cache: never leave the panels on screen.
  addEventListener('pageshow', (e) => {
    if (e.persisted) root.classList.remove('pt-in', 'pt-out', 'pt-arrive');
  });

  // Cover, then go.
  document.addEventListener('click', (e) => {
    if (reduce || e.defaultPrevented || e.button !== 0) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as Element).closest?.('a');
    if (!a || !a.href || a.target === '_blank' || a.hasAttribute('download')) return;
    const url = new URL(a.href, location.href);
    if (url.origin !== location.origin) return;
    // Same page (including in-page anchors): let the browser scroll normally.
    if (url.pathname === location.pathname && url.search === location.search) return;

    e.preventDefault();
    root.classList.remove('pt-out', 'pt-arrive');
    root.classList.add('pt-in');
    afterLast(() => {
      try {
        sessionStorage.setItem(KEY, '1');
      } catch {}
      location.href = url.href;
    });
  });
</script>
