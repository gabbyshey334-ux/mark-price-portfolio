---
// (08) — Certificates, in the style of Lequon's "Selected collaborators" grid:
// numbered cells, name centred, hairlines between.
import SectionHead from './SectionHead.astro';
import { certificates, profile } from '../data/profile';

const items = [
  ...certificates,
  profile.education,
  'Identity verified on Upwork',
];
---

<section class="lq certificates" aria-labelledby="certs-title">
  <SectionHead num="08" label="Certificates" id="certs-title" before="Training and " accent="certificates" />
  <ul class="grid">
    {
      items.map((name, i) => (
        <li class="cell">
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <span class="name">{name}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .lq {
    --paper: #f4f2ee;
    --ink: #111;
    --line: rgba(17, 17, 17, 0.16);
    --orange: #ff4a1f;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Bricolage Grotesque', 'Geist', sans-serif;
    /* Same centred 1120px column as About and Selected work. */
    padding-inline: max(32px, calc((100% - 1120px) / 2));
    padding-bottom: 96px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }
  .cell {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 132px;
    padding: 36px 16px 24px;
    text-align: center;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 350ms ease,
      color 350ms ease;
  }
  .cell:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .n {
    position: absolute;
    left: 12px;
    top: 10px;
    font-family: 'JetBrains Mono', 'Geist Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    opacity: 0.5;
  }
  .cell:hover .n {
    color: var(--orange);
    opacity: 1;
  }
  .name {
    max-width: 22ch;
    font-size: clamp(15px, 0.85rem + 0.4vw, 19px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .cell:nth-child(2n) {
    border-right: 0;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .cell:nth-child(2n) {
      border-right: 1px solid var(--line);
    }
    .cell:nth-child(4n) {
      border-right: 0;
    }
    .cell:nth-last-child(-n + 4) {
      border-bottom: 0;
    }
  }
  @media (max-width: 899px) {
    .cell:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }
</style>
