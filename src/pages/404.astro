---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="wrap nf">
    <h1>This page doesn’t exist.</h1>
    <p><a href="/">Go to the home page</a></p>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
    padding-block: var(--space-6);
  }
</style>
